# LangGraph configuration. / LangGraph 配置。
NEXT_PUBLIC_API_URL=/api/langgraph
NEXT_PUBLIC_ASSISTANT_ID=lead_agent
# Optional; required for Agent Builder deployments. / 可选；Agent Builder 部署需要设置。
# Use "langsmith-api-key" with a LangSmith PAT. / 使用 LangSmith PAT 时设为 "langsmith-api-key"。
NEXT_PUBLIC_AUTH_SCHEME=
# Do not expose this secret with a "NEXT_PUBLIC_" prefix. / 不要添加 "NEXT_PUBLIC_" 前缀，以免向客户端暴露密钥。
LANGSMITH_API_KEY=

# Production LangGraph configuration; uncomment to use. / 生产 LangGraph 配置；取消注释后使用。
# NEXT_PUBLIC_ASSISTANT_ID="lead_agent"
# Set the LangGraph deployment URL. / 设置 LangGraph 部署 URL。
# LANGGRAPH_API_URL="https://my-agent.default.us.langgraph.app"
# Point the client at the website's "/api" proxy. / 将客户端指向网站的 "/api" 代理。
# NEXT_PUBLIC_API_URL="https://my-website.com/api"
# LANGSMITH_API_KEY="lsv2_..."

# Required: DeepSeek model configuration
ZHARNESS_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your-deepseek-api-key

# Required for persistent thread workspaces. Use an absolute host path.
ZHARNESS_HOME=/absolute/path/to/zharness-data

# Explicit checkpoint URI; optional for managed Compose / 显式检查点 URI；使用托管 Compose 时可省略
ZHARNESS_POSTGRES_URI=postgresql://zharness:change-me@127.0.0.1:5432/zharness
LANGGRAPH_STRICT_MSGPACK=true

# Managed PostgreSQL Compose service / 托管的 PostgreSQL Compose 服务
ZHARNESS_POSTGRES_MANAGED=true
ZHARNESS_POSTGRES_USER=zharness
ZHARNESS_POSTGRES_PASSWORD=change-me
ZHARNESS_POSTGRES_DB=zharness
ZHARNESS_POSTGRES_PORT=5432

# Optional: Docker sandbox configuration
ZHARNESS_SANDBOX_IMAGE=zharness-sandbox:latest
ZHARNESS_SANDBOX_MEMORY=512m
ZHARNESS_SANDBOX_NETWORK=true
# ZHARNESS_SANDBOX_USER=1000:1000

# Optional: LangSmith observability
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=zharness-next

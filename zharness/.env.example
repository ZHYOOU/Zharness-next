# ZHarness secrets — keep API keys here, never commit.
# / ZHarness 密钥配置——API Key 保留在此处，切勿提交。
#
# Non-secret settings now live in `zharness/config.yaml`. A set environment
# variable always overrides the matching value in `zharness/config.yaml`.
# `langgraph.json` loads this file for the server, and `scripts/server.sh`
# feeds it to the managed Docker Compose PostgreSQL service.
#
# 非敏感配置现在位于 `zharness/config.yaml`。已设置的环境变量始终覆盖
# `zharness/config.yaml` 中的对应值。`langgraph.json` 会为服务端加载本文件，
# `scripts/server.sh` 会将其传给托管的 Docker Compose PostgreSQL 服务。

# Required: API key for the configured model provider. / 必填：已配置模型提供商的 API Key。
DEEPSEEK_API_KEY=your-deepseek-api-key
# OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key

# Managed PostgreSQL: prefer overriding the managed password here instead of
# writing it into `zharness/config.yaml`. / 托管 PostgreSQL：请优先在此处覆盖托管密码，
# 而不是写入 `zharness/config.yaml`。
# ZHARNESS_POSTGRES_PASSWORD=change-me

# Required only for external PostgreSQL; it overrides all managed settings.
# / 仅外部 PostgreSQL 需要；它会覆盖所有托管配置。
# ZHARNESS_POSTGRES_URI=postgresql://user:password@database.example.com:5432/zharness

# Optional: override values from `zharness/config.yaml`. / 可选：覆盖 `zharness/config.yaml` 中的值。
# ZHARNESS_MODEL=deepseek-chat
# ZHARNESS_HOME=/absolute/path/to/zharness-data

# LangSmith observability. / LangSmith 可观测性。
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=zharness-next

# Strict mode is also enforced in code. / 代码中也会强制启用严格模式。
LANGGRAPH_STRICT_MSGPACK=true